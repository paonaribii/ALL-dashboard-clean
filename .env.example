# Copy to .env and fill in. .env is git-ignored; this example file is the only one committed.
# Login for the local server (npm start). At least 8 characters; SESSION_SECRET at least 32.
DASHBOARD_PASSWORD=
SESSION_SECRET=
# Google Sheet ids (the part between /d/ and /edit in the sheet URL).
SHEET_PENDING_ID=
SHEET_BILLING_ID=
# Service account key used to read those sheets (keep the sheets "Restricted" and share them with the
# service account's client_email as Viewer). The key file is git-ignored.
GOOGLE_SERVICE_ACCOUNT_FILE=./credentials/service_account.json
